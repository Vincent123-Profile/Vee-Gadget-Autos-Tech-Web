{
  "rules": {
    ".read": false,
    ".write": false,

    "products": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true",
      ".indexOn": ["category", "brand", "price", "availability", "featured"]
    },

    "inventory": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true"
    },

    "deviceCatalogue": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true",
      ".indexOn": ["deviceType", "priceEstimate", "targetUsage"]
    },

    "orders": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": false,
      ".indexOn": ["orderRef", "paymentStatus", "orderStatus", "createdAt"]
    },

    "automobiles": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true",
      ".indexOn": ["make", "model", "year", "price", "availability"]
    },

    "automobileEnquiries": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": false
    },

    "veexchange": {
      "rates": {
        ".read": true,
        ".write": "auth != null && auth.token.admin === true"
      },
      "enquiries": {
        ".read": "auth != null && auth.token.admin === true",
        ".write": false,
        ".indexOn": ["enquiryRef", "createdAt"]
      }
    },

    "veexchange_media": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },

    "veemedia_videos": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },

    "media": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true",
      ".indexOn": ["status", "category", "createdAt"]
    },

    "promotions": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true",
      ".indexOn": ["status", "startDate", "endDate"]
    },

    "publicSettings": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },

    "auditLogs": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true",
      ".indexOn": ["timestamp", "action"]
    }
  }
}
